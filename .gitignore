# .claude/ holds project conventions (rules/, hooks/, skills/) that CLAUDE.md
# refers to and the code-review workflow matches against — those are versioned.
# Only the per-machine parts stay ignored.
.claude/settings.local.json
.claude/worktrees/
# Symlinks into the ignored .agents/ tree — tracking them would hand teammates
# dangling links, since the targets are not versioned.
.claude/skills/vercel-react-best-practices
.claude/skills/web-design-guidelines

