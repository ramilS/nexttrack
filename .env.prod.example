# APP
NODE_ENV=production
API_PORT=3001
WEB_PORT=3000
API_URL=https://your-domain.com
WEB_URL=https://your-domain.com
DOMAIN=your-domain.com
# Behind a reverse proxy (nginx/traefik in front of the API container), set
# the hop count so req.ip (used by rate limiting) resolves to the real
# client instead of the proxy. 1 = exactly one hop.
TRUST_PROXY=1

# RATE LIMITING — shared by human and X-Api-Key/machine callers (each gets
# its own bucket, not a higher ceiling). Raise THROTTLE_LONG_LIMIT before
# pointing a high-volume integration (e.g. an error tracker) at this API —
# the default (100/min) is below what a real integration may need, and
# raising it raises the ceiling for humans too. See apps/api/src/config/throttle.config.ts.
THROTTLE_LONG_LIMIT=100

# DATABASE
DATABASE_URL=postgresql://nexttrack:CHANGE_ME@postgres:5432/nexttrack_prod
# pg connection pool (per API process). Tune POOL_MAX against Postgres max_connections.
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# pg pool timeouts (ms). 0 disables: connection waits forever / idle never closes.
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# AUTH
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AUTH (local login)
AUTH_LOCAL_ENABLED=true

# VALKEY (Redis-compatible). Host = compose service name; keep the password in
# VALKEY_URL identical to VALKEY_PASSWORD (the `valkey` service's --requirepass).
VALKEY_URL=valkey://:CHANGE_ME@valkey:6379
VALKEY_PASSWORD=CHANGE_ME

# MAIL (production SMTP)
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_SECURE=true
MAIL_FROM="NextTrack <noreply@your-domain.com>"
MAIL_USER=CHANGE_ME
MAIL_PASS=CHANGE_ME

# S3 OBJECT STORAGE (Garage). The `garage` service creates its access key
# from S3_ACCESS_KEY / S3_SECRET_KEY on first boot.
# Key id: >=8 chars of [A-Za-z0-9-_.]; secret: >=16 printable ASCII chars.
# A key cannot be re-keyed by changing these later: Garage refuses to start if
# the stored secret differs from S3_SECRET_KEY.
# Internal compose hostname on purpose: downloads and thumbnails stream through
# the API (GET /api/issues/:id/attachments/:id/download), so the object store is
# never exposed through nginx and needs no public hostname or TLS cert.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME_min_16_chars
S3_BUCKET=nexttrack-attachments
# Browser cache lifetime (private) of a served attachment; also how long a
# deleted or revoked file stays viewable from a cache. 0 disables.
ATTACHMENT_CACHE_MAX_AGE_SECONDS=60

# SEARCH ENGINE (OpenSearch)
SEARCH_ENGINE_URL=http://opensearch:9200

# INVITE
INVITE_TOKEN_TTL_HOURS=72

# SSO / OAuth
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars
SSO_STATE_TTL=600
SSO_FINALIZE_CODE_TTL=30

# WEBSOCKET
WS_CORS_ORIGINS=https://your-domain.com

# GARAGE (for docker-compose) — cluster RPC secret: `openssl rand -hex 32`
GARAGE_RPC_SECRET=CHANGE_ME_64_hex_chars

# POSTGRES (for docker-compose)
POSTGRES_DB=nexttrack_prod
POSTGRES_USER=nexttrack
POSTGRES_PASSWORD=CHANGE_ME
